# Streamlit Cloud secrets template
# Copy these keys into Streamlit Cloud UI: App settings → Secrets

# --- Supabase ---
SUPABASE_URL = ""
SUPABASE_KEY = ""
SUPABASE_SERVICE_ROLE_KEY = ""  # optional
SUPABASE_DISABLED = "false"
SUPABASE_VECTOR_RPC = "match_vpop_tracks"
SUPABASE_LYRICS_RPC = "match_lyrics"

# --- Gemini ---
GEMINI_API_KEY = ""
GEMINI_MODEL = "models/gemini-2.0-flash"
GEMINI_API_KEYS = ""  # optional: comma-separated or newline-separated
GEMINI_INTENT_MODEL = "gemini-2.0-flash"

# --- Supabase Storage (Models) ---
SUPABASE_MODELS_BUCKET = "ml_models"
SUPABASE_MODELS_PREFIX = ""  # optional folder/prefix
MODEL_CACHE_DIR = ""         # optional
MODELS_PREFER_STORAGE = "true"
MODELS_FORCE_STORAGE = ""

# --- Spotify (optional) ---
SPOTIFY_CLIENT_ID = ""
SPOTIFY_CLIENT_SECRET = ""
